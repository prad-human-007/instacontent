# Server-only Instagram credentials
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Public HTTPS base URL through which Meta can download temporary MP4 files
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=

# Meta Graph API version used by the server-side Instagram service
INSTAGRAM_GRAPH_API_VERSION=

# Cloudflare Access configuration for production administrator authorization
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
INSTAGRAM_PUBLISH_ADMIN_EMAILS=
