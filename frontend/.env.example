# Server-only Instagram credentials
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Public HTTPS origin for this deployed application (no path)
INSTACONTENT_PUBLIC_BASE_URL=

# 32+ character HMAC secret used only for signed background-browser jobs
INSTAGRAM_AUTOMATION_SIGNING_KEY=

# Base64-encoded 32-byte AES key used to encrypt refreshed Instagram tokens in R2
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Public HTTPS base URL through which Meta can download temporary MP4 files
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=

# Meta Graph API version used by the server-side Instagram service
INSTAGRAM_GRAPH_API_VERSION=

# Cloudflare Access configuration for production administrator authorization
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
INSTAGRAM_PUBLISH_ADMIN_EMAILS=

# Cloudflare Access service token allowed to open the protected Modi page
CLOUDFLARE_ACCESS_SERVICE_CLIENT_ID=
CLOUDFLARE_ACCESS_SERVICE_CLIENT_SECRET=
